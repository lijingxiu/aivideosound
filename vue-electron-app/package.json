{
  "name": "vue-electron-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "server": "node server/index.js",
    "electron:serve": "cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build && node -e \"const {execFileSync}=require('child_process'); execFileSync(require('ffmpeg-static'),['-version'],{stdio:'ignore'}); console.log('[ffmpeg] binary OK')\" && chmod +x node_modules/ffmpeg-static/ffmpeg && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --x64"
  },
  "build": {
    "appId": "com.example.myapp",
    "productName": "音译",
    "directories": {
      "output": "ipa"
    },
    "files": [
      "**/*",
      "!src"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "public/fonts/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  },
  "main": "./out/main/main.js",
  "dependencies": {
    "core-js": "^3.8.3",
    "electron-log": "^5.4.4",
    "element-ui": "^2.15.14",
    "ffmpeg-static": "^5.3.0",
    "vue": "^2.7.16",
    "vue-router": "^3.6.5",
    "vuex": "^3.6.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-plugin-vuex": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "sass": "^1.32.7",
    "sass-loader": "^12.0.0"
  }
}
